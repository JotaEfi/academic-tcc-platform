APP_NAME="Sistema de Gerenciamento e Avaliacao de TCCs"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ─── Banco de Dados ────────────────────────────────────────────────────────────
# Desenvolvimento local (Docker): use os valores abaixo exatamente
# VPS/Produção: substitua pelos valores do seu servidor
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=tcc_database
DB_USERNAME=tcc_user
DB_PASSWORD=tcc_password

# ─── Session & Cache ───────────────────────────────────────────────────────────
# Use "file" dentro do Docker para evitar dependência do banco no boot
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=file

# ─── Mail ──────────────────────────────────────────────────────────────────────
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ─── Variáveis de Deploy (VPS / docker-compose.prod.yml) ──────────────────────
# Preencha estas variáveis no servidor antes de rodar docker compose prod
# IMAGE_TAG=latest
# APP_URL=https://seusite.com.br
